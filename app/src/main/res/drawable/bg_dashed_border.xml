<?xml version="1.0" encoding="utf-8"?>
<!-- Zona punteada para cámara, GPS y adjuntos. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/agro_input_bg" />
    <stroke
        android:width="@dimen/stroke_selected"
        android:color="@color/agro_primary"
        android:dashGap="6dp"
        android:dashWidth="10dp" />
    <corners android:radius="@dimen/radius_lg" />
</shape>
