<?xml version="1.0" encoding="utf-8"?>
<!-- Navegación del rol Vendedor. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_seller"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.jmariodev.agrodigital.ui.seller.dashboard.SellerDashboardFragment"
        android:label="@string/nav_seller_panel"
        tools:layout="@layout/fragment_seller_dashboard">
        <action
            android:id="@+id/action_dashboard_to_form"
            app:destination="@id/productFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/sellerProductsFragment"
        android:name="com.jmariodev.agrodigital.ui.seller.products.SellerProductsFragment"
        android:label="@string/nav_my_products"
        tools:layout="@layout/fragment_seller_products">
        <action
            android:id="@+id/action_products_to_form"
            app:destination="@id/productFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/productFormFragment"
        android:name="com.jmariodev.agrodigital.ui.seller.products.ProductFormFragment"
        android:label="@string/form_title_new"
        tools:layout="@layout/fragment_product_form">
        <argument
            android:name="productId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="type"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/ordersFragment"
        android:name="com.jmariodev.agrodigital.ui.common.orders.OrdersFragment"
        android:label="@string/nav_received_orders"
        tools:layout="@layout/fragment_orders" />

    <fragment
        android:id="@+id/orderDetailFragment"
        android:name="com.jmariodev.agrodigital.ui.common.orders.OrderDetailFragment"
        android:label="@string/order_detail_title"
        tools:layout="@layout/fragment_order_detail">
        <argument
            android:name="orderId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.jmariodev.agrodigital.ui.common.profile.ProfileFragment"
        android:label="@string/nav_my_profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.jmariodev.agrodigital.ui.common.profile.EditProfileFragment"
        android:label="@string/edit_profile_title"
        tools:layout="@layout/fragment_edit_profile" />
</navigation>
