<?xml version="1.0" encoding="utf-8"?>
<!-- Producto en moderación con acciones del administrador. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_md">

            <ImageView
                android:id="@+id/ivProduct"
                android:layout_width="@dimen/thumb_size"
                android:layout_height="@dimen/thumb_size"
                android:background="@drawable/bg_image_box"
                android:contentDescription="@string/cd_product_image"
                android:padding="@dimen/thumb_padding"
                android:src="@drawable/img_bull"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/agro_bull_brown" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_sm"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Agro.SubtitleStrong"
                app:layout_constraintEnd_toStartOf="@id/tvType"
                app:layout_constraintStart_toEndOf="@id/ivProduct"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Brahman Max Pro" />

            <TextView
                android:id="@+id/tvType"
                style="@style/Widget.Agro.Badge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="@string/type_semen" />

            <TextView
                android:id="@+id/tvSeller"
                style="@style/Widget.Agro.Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/tvName"
                app:layout_constraintTop_toBottomOf="@id/tvName"
                tools:text="Finca La Aurora" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.Agro.Price"
                app:layout_constraintStart_toStartOf="@id/tvName"
                app:layout_constraintTop_toBottomOf="@id/tvSeller"
                tools:text="$480.000" />

            <TextView
                android:id="@+id/tvDate"
                style="@style/Widget.Agro.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBaseline_toBaselineOf="@id/tvPrice"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Hoy" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Motivo de reporte -->
        <LinearLayout
            android:id="@+id/reportBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@drawable/bg_warning_box"
            android:orientation="vertical"
            android:padding="@dimen/space_md"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvReason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Agro.Body"
                android:textColor="@color/agro_warning_dark"
                tools:text="Motivo: Certificado inválido" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnForceApprove"
                    style="@style/Widget.Agro.Button.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/moderation_force_approve" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRemove"
                    style="@style/Widget.Agro.Button.Destructive"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:minHeight="@dimen/button_height_small"
                    android:text="@string/moderation_remove" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Acciones -->
        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetails"
                style="@style/Widget.Agro.Button.Text.Neutral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_details"
                app:icon="@drawable/ic_eye" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApprove"
                style="@style/Widget.Agro.Button.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_approve"
                app:icon="@drawable/ic_check" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFlag"
                style="@style/Widget.Agro.Button.Text.Warning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_flag"
                app:icon="@drawable/ic_flag" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
