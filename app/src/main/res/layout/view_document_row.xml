<?xml version="1.0" encoding="utf-8"?>
<!-- Documento o credencial verificada (certificado ICA, registro, etc.). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Agro.Card.Success"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_sm"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target_min"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_base"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_base"
        android:paddingBottom="@dimen/space_md">

        <ImageView
            android:id="@+id/ivStart"
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/agro_primary" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Agro.Subtitle"
            android:textColor="@color/agro_primary_dark"
            tools:text="@string/doc_sanitary" />

        <ImageView
            android:id="@+id/ivEnd"
            android:layout_width="@dimen/icon_sm"
            android:layout_height="@dimen/icon_sm"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_document"
            app:tint="@color/agro_primary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
