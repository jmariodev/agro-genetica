<?xml version="1.0" encoding="utf-8"?>
<!-- Usuario registrado con rol, estado y menú de acciones (editar, suspender, eliminar). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAvatar"
            android:layout_width="@dimen/avatar_sm"
            android:layout_height="@dimen/avatar_sm"
            android:background="@color/agro_primary_light"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_md"
            android:src="@drawable/ic_person"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Agro.Circle"
            app:tint="@color/agro_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Agro.SubtitleStrong"
                tools:text="Carlos Mendoza" />

            <TextView
                android:id="@+id/tvEmail"
                style="@style/Widget.Agro.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="vendedor@agro.co" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRole"
                    style="@style/Widget.Agro.Badge"
                    tools:text="@string/role_seller" />

                <TextView
                    android:id="@+id/tvStatus"
                    style="@style/Widget.Agro.Badge"
                    android:layout_marginStart="@dimen/space_xs"
                    tools:text="@string/status_active" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMore"
            style="@style/Widget.Agro.Button.IconOnly.Ghost"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:contentDescription="@string/cd_more_actions"
            app:icon="@drawable/ic_more_vert" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
