<?xml version="1.0" encoding="utf-8"?>
<!-- Línea de producto en resúmenes de pedido. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_sm">

    <ImageView
        android:id="@+id/ivProduct"
        android:layout_width="@dimen/thumb_small"
        android:layout_height="@dimen/thumb_small"
        android:background="@drawable/bg_image_box"
        android:importantForAccessibility="no"
        android:padding="@dimen/space_sm"
        android:src="@drawable/img_bull"
        app:tint="@color/agro_bull_brown" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Agro.Subtitle"
            tools:text="Brahman Elite x2" />

        <TextView
            android:id="@+id/tvType"
            style="@style/Widget.Agro.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="@string/type_semen" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Agro.SubtitleStrong"
        tools:text="$900.000" />
</LinearLayout>
