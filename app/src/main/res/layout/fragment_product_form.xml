<?xml version="1.0" encoding="utf-8"?>
<!-- Crear / editar producto: cámara nativa, GPS y certificado ICA en PDF (RF-24, RF-26). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agro_surface"
    tools:context=".ui.seller.products.ProductFormFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_lg">

            <TextView
                style="@style/Widget.Agro.Text.FieldLabel"
                android:text="@string/label_product_type" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedButton="@id/btnTypeSemen"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypeSemen"
                    style="@style/Widget.Agro.Button.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/type_semen" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypeEmbryo"
                    style="@style/Widget.Agro.Button.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/type_embryo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypeLive"
                    style="@style/Widget.Agro.Button.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/type_live" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Fotografía -->
            <TextView
                style="@style/Widget.Agro.Text.FieldLabel"
                android:text="@string/label_photo" />

            <FrameLayout
                android:id="@+id/photoZone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/photo_zone_height"
                android:background="@drawable/bg_dashed_border">

                <LinearLayout
                    android:id="@+id/photoPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_box_large"
                        android:layout_height="@dimen/icon_box_large"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/agro_primary_light"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/space_base"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/agro_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/form_photo_title"
                        android:textAppearance="@style/TextAppearance.Agro.SubtitleStrong" />

                    <TextView
                        style="@style/Widget.Agro.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/form_photo_subtitle" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCamera"
                            style="@style/Widget.Agro.Button.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/form_open_camera"
                            app:icon="@drawable/ic_camera" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGallery"
                            style="@style/Widget.Agro.Button.Text.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:text="@string/form_gallery" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_product_image"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetakePhoto"
                    style="@style/Widget.Agro.Button.IconOnly.Circle"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:layout_gravity="top|end"
                    android:layout_margin="@dimen/space_sm"
                    android:contentDescription="@string/cd_change_photo"
                    android:visibility="gone"
                    app:icon="@drawable/ic_camera" />
            </FrameLayout>

            <!-- Datos -->
            <TextView
                android:id="@+id/tvNameLabel"
                style="@style/Widget.Agro.Text.FieldLabel"
                android:text="@string/label_product_name" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_product_name"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.Agro.Text.FieldLabel"
                android:text="@string/label_breed" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBreed"
                style="@style/Widget.Agro.TextInputLayout.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actBreed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_breed"
                    android:inputType="none"
                    app:simpleItems="@array/breeds" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.Agro.Text.FieldLabel"
                android:text="@string/label_ica_registry" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilIca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:helperText="@string/helper_ica">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_ica"
                    android:inputType="textCapCharacters" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.Agro.Text.FieldLabel"
                        android:text="@string/label_abv" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAbv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:prefixText="@string/abv_prefix">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_abv"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStockLabel"
                        style="@style/Widget.Agro.Text.FieldLabel"
                        android:text="@string/label_stock" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilStock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_stock"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Solo para ejemplares vivos -->
            <LinearLayout
                android:id="@+id/groupLive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.Agro.Text.FieldLabel"
                        android:text="@string/label_age" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:suffixText="@string/suffix_years">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_zero"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.Agro.Text.FieldLabel"
                        android:text="@string/label_weight" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilWeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:suffixText="@string/suffix_kg">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_zero"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPriceLabel"
                style="@style/Widget.Agro.Text.FieldLabel"
                android:text="@string/label_price" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:prefixText="@string/currency_prefix">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_zero"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.Agro.Text.FieldLabel"
                android:text="@string/label_description" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:counterEnabled="true"
                app:counterMaxLength="300">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:hint="@string/hint_description"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Ubicación GPS -->
            <TextView
                style="@style/Widget.Agro.Text.FieldLabel"
                android:text="@string/label_farm_location" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGps"
                style="@style/Widget.Agro.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/form_gps"
                app:icon="@drawable/ic_location" />

            <TextView
                android:id="@+id/tvLocation"
                style="@style/Widget.Agro.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/form_gps_hint" />

            <!-- Certificado sanitario -->
            <TextView
                style="@style/Widget.Agro.Text.FieldLabel"
                android:text="@string/label_certificate" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAttachPdf"
                style="@style/Widget.Agro.Button.Soft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/form_attach_pdf"
                app:icon="@drawable/ic_upload" />

            <TextView
                android:id="@+id/tvPdfName"
                style="@style/Widget.Agro.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:drawablePadding="@dimen/space_xs"
                android:gravity="center"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_document"
                app:drawableTint="@color/agro_primary"
                tools:text="certificado_ica.pdf"
                tools:visibility="visible" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_base"
                android:background="@drawable/bg_warning_box"
                android:drawablePadding="@dimen/space_sm"
                android:gravity="center_vertical"
                android:padding="@dimen/space_md"
                android:text="@string/form_review_note"
                android:textAppearance="@style/TextAppearance.Agro.Caption"
                android:textColor="@color/agro_warning_dark"
                app:drawableStartCompat="@drawable/ic_clock"
                app:drawableTint="@color/agro_warning_dark" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:padding="@dimen/screen_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/form_publish"
            app:icon="@drawable/ic_upload" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
