<?xml version="1.0" encoding="utf-8"?>
<!-- Paso de la línea de tiempo del pedido. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivDot"
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:background="@drawable/bg_circle"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_xs"
            android:src="@drawable/ic_check"
            app:tint="@color/agro_white" />

        <View
            android:id="@+id/line"
            android:layout_width="@dimen/timeline_line_width"
            android:layout_height="@dimen/timeline_line_height"
            android:background="@color/agro_outline" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Agro.SubtitleStrong"
            tools:text="@string/status_paid" />

        <TextView
            android:id="@+id/tvStepDetail"
            style="@style/Widget.Agro.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="@string/timeline_paid" />
    </LinearLayout>
</LinearLayout>
