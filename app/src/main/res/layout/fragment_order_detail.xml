<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.common.orders.OrderDetailFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Encabezado -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_base">

                    <ImageView
                        android:layout_width="@dimen/icon_box"
                        android:layout_height="@dimen/icon_box"
                        android:background="@drawable/bg_rounded"
                        android:backgroundTint="@color/agro_primary_light"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/space_sm"
                        android:src="@drawable/ic_receipt"
                        app:tint="@color/agro_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Agro.Title"
                            tools:text="ORD-2024-001" />

                        <TextView
                            android:id="@+id/tvDate"
                            style="@style/Widget.Agro.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="15 abr 2026 · MercadoPago" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatus"
                        style="@style/Widget.Agro.Badge"
                        tools:text="@string/status_paid" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Seguimiento -->
            <TextView
                style="@style/Widget.Agro.Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/order_tracking" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:id="@+id/containerTimeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Productos -->
            <TextView
                style="@style/Widget.Agro.Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/order_products" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base">

                    <LinearLayout
                        android:id="@+id/containerItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm" />

                    <include
                        android:id="@+id/rowSubtotal"
                        layout="@layout/view_price_row" />

                    <include
                        android:id="@+id/rowShipping"
                        layout="@layout/view_price_row" />

                    <include
                        android:id="@+id/rowTotal"
                        layout="@layout/view_price_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contraparte y dirección -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_base"
                    android:paddingEnd="@dimen/space_base">

                    <include
                        android:id="@+id/rowCounterpart"
                        layout="@layout/view_info_row" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/rowAddress"
                        layout="@layout/view_info_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_truck"
            tools:text="@string/order_mark_shipped" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Agro.Button.Outlined.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/order_cancel"
            app:icon="@drawable/ic_close" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
