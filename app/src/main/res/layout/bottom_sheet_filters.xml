<?xml version="1.0" encoding="utf-8"?>
<!-- Hoja inferior de filtros del catálogo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_lg"
    android:paddingEnd="@dimen/space_lg"
    android:paddingBottom="@dimen/space_lg">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/filters_title"
        android:textAppearance="@style/TextAppearance.Agro.Headline" />

    <TextView
        style="@style/Widget.Agro.Text.FieldLabel"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/filters_price" />

    <TextView
        android:id="@+id/tvPriceRange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Agro.Price"
        tools:text="$0 - $2.000.000" />

    <com.google.android.material.slider.RangeSlider
        android:id="@+id/sliderPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/filters_price"
        android:stepSize="50000"
        android:valueFrom="0"
        android:valueTo="1000000"
        app:values="@array/price_range_default" />

    <TextView
        style="@style/Widget.Agro.Text.FieldLabel"
        android:text="@string/filters_breed" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipsBreed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        style="@style/Widget.Agro.Text.FieldLabel"
        android:text="@string/filters_options" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbCertified"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/filters_only_certified" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            style="@style/Widget.Agro.Button.Outlined.Neutral"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_clear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            style="@style/Widget.Agro.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:text="@string/action_apply" />
    </LinearLayout>
</LinearLayout>
