<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agro_surface"
    android:fillViewport="true"
    tools:context=".ui.auth.BiometricSetupFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/space_xl">

        <View
            android:id="@+id/headerBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_header_gradient"
            app:layout_constraintBottom_toBottomOf="@id/headerAnchor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            style="@style/Widget.Agro.Button.IconOnly.Translucent"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginTop="@dimen/space_base"
            android:layout_marginEnd="@dimen/space_base"
            android:contentDescription="@string/cd_close"
            app:icon="@drawable/ic_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/biometric_header"
            android:textAppearance="@style/TextAppearance.Agro.Headline"
            android:textColor="@color/agro_white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnClose" />

        <TextView
            android:id="@+id/tvHeaderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/biometric_header_subtitle"
            android:textAppearance="@style/TextAppearance.Agro.Body"
            android:textColor="@color/agro_white_70"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle" />

        <!-- Círculo con la huella: mitad sobre la cabecera, mitad sobre el fondo blanco -->
        <FrameLayout
            android:id="@+id/fingerprintCircle"
            android:layout_width="@dimen/biometric_circle"
            android:layout_height="@dimen/biometric_circle"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/agro_primary_light"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHeaderSubtitle">

            <ImageView
                android:layout_width="@dimen/biometric_inner"
                android:layout_height="@dimen/biometric_inner"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/agro_success_stroke"
                android:contentDescription="@string/cd_fingerprint"
                android:padding="@dimen/space_lg"
                android:src="@drawable/ic_fingerprint"
                app:tint="@color/agro_primary_dark" />
        </FrameLayout>

        <Space
            android:id="@+id/headerAnchor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/fingerprintCircle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/fingerprintCircle" />

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fingerprintCircle">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/biometric_title"
                android:textAppearance="@style/TextAppearance.Agro.Headline" />

            <TextView
                style="@style/Widget.Agro.Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/biometric_body" />

            <include
                android:id="@+id/featureInstant"
                layout="@layout/view_feature_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg" />

            <include
                android:id="@+id/featureSecure"
                layout="@layout/view_feature_row" />

            <TextView
                android:id="@+id/tvSensorHint"
                style="@style/Widget.Agro.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_lg"
                android:drawablePadding="@dimen/space_sm"
                android:gravity="center_vertical"
                android:text="@string/biometric_sensor_hint"
                app:drawableStartCompat="@drawable/bg_dot"
                app:drawableTint="@color/agro_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/biometric_register"
                app:icon="@drawable/ic_fingerprint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLater"
                style="@style/Widget.Agro.Button.Outlined.Neutral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/biometric_later" />

            <TextView
                style="@style/Widget.Agro.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_base"
                android:gravity="center"
                android:text="@string/biometric_footnote" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
