<?xml version="1.0" encoding="utf-8"?>
<!-- Pasarela de pagos: dirección, resumen, método de pago y confirmación con huella. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.buyer.checkout.CheckoutFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Dirección de envío -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawablePadding="@dimen/space_sm"
                            android:gravity="center_vertical"
                            android:text="@string/checkout_address"
                            android:textAppearance="@style/TextAppearance.Agro.Title"
                            app:drawableStartCompat="@drawable/ic_location"
                            app:drawableTint="@color/agro_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChangeAddress"
                            style="@style/Widget.Agro.Button.Text.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_change" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:background="@drawable/bg_rounded"
                        android:orientation="vertical"
                        android:padding="@dimen/space_base">

                        <TextView
                            android:id="@+id/tvAddressName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Agro.SubtitleStrong"
                            tools:text="Finca La Esperanza" />

                        <TextView
                            android:id="@+id/tvAddressLine"
                            style="@style/Widget.Agro.Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Vereda El Progreso, Km 15 · Montería, Córdoba" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Resumen del pedido -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/summary_title"
                        android:textAppearance="@style/TextAppearance.Agro.Title" />

                    <LinearLayout
                        android:id="@+id/containerItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:orientation="vertical" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm" />

                    <include
                        android:id="@+id/rowSubtotal"
                        layout="@layout/view_price_row" />

                    <include
                        android:id="@+id/rowShipping"
                        layout="@layout/view_price_row" />

                    <include
                        android:id="@+id/rowTotal"
                        layout="@layout/view_price_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Método de pago -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/space_sm"
                        android:gravity="center_vertical"
                        android:text="@string/checkout_payment_method"
                        android:textAppearance="@style/TextAppearance.Agro.Title"
                        app:drawableStartCompat="@drawable/ic_card"
                        app:drawableTint="@color/agro_primary" />

                    <include
                        android:id="@+id/payMercadoPago"
                        layout="@layout/view_payment_option" />

                    <include
                        android:id="@+id/payPse"
                        layout="@layout/view_payment_option" />

                    <include
                        android:id="@+id/payEpayco"
                        layout="@layout/view_payment_option" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_rounded"
                android:backgroundTint="@color/agro_primary_light"
                android:drawablePadding="@dimen/space_sm"
                android:gravity="center_vertical"
                android:padding="@dimen/space_base"
                android:text="@string/checkout_secure"
                android:textAppearance="@style/TextAppearance.Agro.Caption"
                android:textColor="@color/agro_primary_dark"
                app:drawableStartCompat="@drawable/ic_shield"
                app:drawableTint="@color/agro_primary" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/checkout_terms" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/checkout_pay"
            app:icon="@drawable/ic_fingerprint"
            app:iconSize="@dimen/icon_md" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
