<?xml version="1.0" encoding="utf-8"?>
<!-- Cabecera del menú lateral: datos del usuario con sesión. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_header_gradient"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_lg"
    android:paddingTop="@dimen/space_xxl"
    android:paddingEnd="@dimen/space_lg"
    android:paddingBottom="@dimen/space_lg">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAvatar"
        android:layout_width="@dimen/avatar_md"
        android:layout_height="@dimen/avatar_md"
        android:background="@color/agro_white_20"
        android:contentDescription="@string/cd_avatar"
        android:padding="@dimen/space_md"
        android:src="@drawable/ic_person"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Agro.Circle"
        app:tint="@color/agro_white" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:textAppearance="@style/TextAppearance.Agro.Title"
        android:textColor="@color/agro_white"
        tools:text="Carlos Mendoza" />

    <TextView
        android:id="@+id/tvFarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Agro.Body"
        android:textColor="@color/agro_white_70"
        tools:text="Hacienda El Progreso" />

    <TextView
        android:id="@+id/tvRole"
        style="@style/Widget.Agro.Badge"
        android:layout_marginTop="@dimen/space_sm"
        tools:text="@string/role_seller" />
</LinearLayout>
