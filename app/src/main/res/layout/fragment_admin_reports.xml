<?xml version="1.0" encoding="utf-8"?>
<!-- Reporte de ventas: resumen, gráfico de barras (vistas nativas, sin librerías) y rankings. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.admin.reports.AdminReportsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:checkedChip="@id/chipMonth"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/period_week" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/period_month" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/period_year" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Resumen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_base"
            android:background="@drawable/bg_hero_card"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <TextView
                android:id="@+id/tvPeriodLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Agro.Body"
                android:textColor="@color/agro_white_70"
                tools:text="Ventas del periodo" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.Agro.Display"
                android:textColor="@color/agro_white"
                tools:text="$45.000.000" />

            <TextView
                android:id="@+id/tvTrend"
                style="@style/Widget.Agro.Badge"
                android:layout_marginTop="@dimen/space_sm"
                android:backgroundTint="@color/agro_white_20"
                android:drawablePadding="@dimen/space_xs"
                android:textColor="@color/agro_white"
                app:drawableStartCompat="@drawable/ic_trending"
                app:drawableTint="@color/agro_white"
                tools:text="+18% vs periodo anterior" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_base"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOrders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Agro.Title"
                        android:textColor="@color/agro_white"
                        tools:text="128" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/report_orders"
                        android:textAppearance="@style/TextAppearance.Agro.Caption"
                        android:textColor="@color/agro_white_70" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAverage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Agro.Title"
                        android:textColor="@color/agro_white"
                        tools:text="$351.000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/report_average_ticket"
                        android:textAppearance="@style/TextAppearance.Agro.Caption"
                        android:textColor="@color/agro_white_70" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Gráfico -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_base">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_base">

                <TextView
                    android:id="@+id/tvChartTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Agro.Title"
                    tools:text="@string/report_chart_month" />

                <LinearLayout
                    android:id="@+id/chartContainer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/chart_height"
                    android:layout_marginTop="@dimen/space_base"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Rankings -->
        <TextView
            style="@style/Widget.Agro.Text.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/report_top_products" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:id="@+id/containerTopProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_base"
                android:paddingEnd="@dimen/space_base"
                android:paddingBottom="@dimen/space_base" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.Agro.Text.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/report_top_sellers" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:id="@+id/containerTopSellers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_base"
                android:paddingEnd="@dimen/space_base"
                android:paddingBottom="@dimen/space_base" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.Agro.Text.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/report_recent_sales" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentSales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_order" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExport"
            style="@style/Widget.Agro.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_base"
            android:text="@string/report_export"
            app:icon="@drawable/ic_download" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
